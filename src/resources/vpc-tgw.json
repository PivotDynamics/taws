          "default": "-"
        },
        "OwnerId": {
          "source": "/ownerId",
          "default": "-"
        },
        "Description": {
          "source": "/description",
          "default": "-"
        },
        "CreationTime": {
          "source": "/creationTime",
          "default": "-"
        },
        "Options": {
          "source": "/options"
        },
        "Tags": {
          "source": "/tagSet/item",
