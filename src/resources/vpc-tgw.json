          "json_path": "TransitGatewayId",
          "width": 28
        },
        {
          "header": "STATE",
          "json_path": "State",
          "width": 12,
          "color_map": "state"
        },
        {
          "header": "ASN",
          "json_path": "Options.amazonSideAsn",
          "width": 14
        },
        {
          "header": "DEFAULT RT",
          "json_path": "Options.associationDefaultRouteTableId",
          "width": 28
